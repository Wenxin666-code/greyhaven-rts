# Build outputs are distributed as release assets.
/*.exe
/*.pdb
*.user
.vs/
.cache/
node_modules/
.DS_Store
Thumbs.db

# Local pre-edit snapshots; curated art history is tracked.
/art/archive/*-before-*/

# Offline authoring caches.
__pycache__/
*.pyc

# Regenerable frames; model sources, materials and runtime packs are tracked.
/art/source/**/frames/
