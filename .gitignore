# Build outputs are distributed as release assets.
/*.exe
/*.pdb
*.user
.vs/
.cache/
node_modules/
.DS_Store
Thumbs.db

# Local pre-edit snapshots; curated art history is tracked.
/art/archive/*-before-*/

# Offline authoring caches.
__pycache__/
*.pyc

# Regenerable frames; model sources, materials and runtime packs are tracked.
/art/source/**/frames/
/docs/infantry-20261110/animation-frames/
/docs/infantry-motion-20261110/preview-frames/

# Diagnostic keyframes; keep the curated contact sheet and video.
/docs/infantry-motion-20261110/at-*.png
/docs/infantry-motion-20261110/squad-*.png
/docs/infantry-motion-20261110/sniper-*.png

# Godot imports and local export bundles.
.godot/
bin/
obj/
/game/exports/
/legacy/windows/*.exe
/legacy/windows/*.pdb
/legacy/windows/exports/
