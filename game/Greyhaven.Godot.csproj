<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ArtRoot>../art/source</ArtRoot>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(ArtRoot)/console/harbor.png;$(ArtRoot)/console/plate.png;$(ArtRoot)/runtime-sprites/packed/runtime-sprites.pak;$(ArtRoot)/runtime-sprites/packed/runtime-cells.pak" LogicalName="%(Filename)%(Extension)" />
    <Compile Include="scripts/**/*.cs" />
    <EmbeddedResource Include="$(ArtRoot)/fieldworks-v01/idle/oilwell-front-base.png;$(ArtRoot)/fieldworks-v01/idle/oilwell-front-paint.png" LogicalName="%(Filename)%(Extension)" />
    <ProjectReference Include="core/Greyhaven.Core.csproj" />
    <EmbeddedResource Include="$(ArtRoot)/tank-prototype/packed/tank-sockets.csv;$(ArtRoot)/isometric/ground.png" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
